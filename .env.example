# DEV defaults only. Production: generate strong values via a secret manager;
# never commit real credentials. Copy to infra/.env for local compose overrides.
POSTGRES_USER=listguard
POSTGRES_PASSWORD=listguard
POSTGRES_DB=listguard
DATABASE_URL=postgresql+psycopg://listguard:listguard@db:5432/listguard
REDIS_URL=redis://redis:6379/0
